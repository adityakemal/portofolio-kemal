<style id="wp-custom-css">
/* Arnatech hero subtle circuit-electric motion */
.home .wp-block-cover.alignfull{overflow:hidden;}
.home #hero-spline-layer{
  position:absolute !important;
  inset:0;
  pointer-events:none;
  overflow:hidden;
  z-index:1;
  background:
    /* moving electric beam */
    linear-gradient(112deg,
      rgba(11,16,32,0) 0%,
      rgba(11,16,32,0) 44%,
      rgba(0,207,255,.18) 49%,
      rgba(34,211,238,.34) 51%,
      rgba(0,184,255,.18) 53%,
      rgba(11,16,32,0) 58%,
      rgba(11,16,32,0) 100%
    ) -35% 0 / 180% 100% no-repeat,
    /* circuit vertical traces */
    linear-gradient(90deg, rgba(0,207,255,.10) 1px, transparent 1px) 0 0 / 56px 56px,
    /* circuit horizontal traces */
    linear-gradient(0deg, rgba(0,184,255,.09) 1px, transparent 1px) 0 0 / 56px 56px,
    /* glow nodes */
    radial-gradient(circle at 18% 26%, rgba(0,207,255,.22) 0, rgba(0,207,255,0) 20%),
    radial-gradient(circle at 74% 62%, rgba(34,211,238,.20) 0, rgba(34,211,238,0) 18%);
  opacity:.55;
  animation: arnaCircuitBeam 8.4s linear infinite, arnaCircuitGrid 18s linear infinite;
}
.home .wp-block-cover.alignfull .wp-block-cover__inner-container{position:relative;z-index:2;}

@keyframes arnaCircuitBeam{
  0%{background-position:-35% 0,0 0,0 0,0 0,0 0;}
  100%{background-position:135% 0,0 0,0 0,0 0,0 0;}
}
@keyframes arnaCircuitGrid{
  0%{background-position:-35% 0,0 0,0 0,0 0,0 0;}
  100%{background-position:135% 0,56px 0,0 56px,0 0,0 0;}
}

@media (max-width: 921px){
  .home #hero-spline-layer{
    opacity:.46;
    background-size:170% 100%,44px 44px,44px 44px,auto,auto;
    animation-duration:7.4s,14s;
  }
}


/* Contact section: subtle circuit-electric overlay */
.home #contact{
position:relative;overflow:hidden;isolation:isolate;
background:
linear-gradient(135deg,#0B1020 0%,#0A162B 38%,#0C2340 72%,#123A63 100%),
linear-gradient(112deg,rgba(11,16,32,0) 0%,rgba(11,16,32,0) 46%,rgba(0,207,255,.14) 50%,rgba(34,211,238,.24) 52%,rgba(0,184,255,.14) 54%,rgba(11,16,32,0) 60%,rgba(11,16,32,0) 100%) -40% 0/180% 100% no-repeat,
linear-gradient(90deg,rgba(0,207,255,.08) 1px,transparent 1px) 0 0/64px 64px,
linear-gradient(0deg,rgba(0,184,255,.07) 1px,transparent 1px) 0 0/64px 64px,
radial-gradient(circle at 22% 24%,rgba(0,207,255,.16) 0,rgba(0,207,255,0) 22%),
radial-gradient(circle at 78% 68%,rgba(34,211,238,.14) 0,rgba(34,211,238,0) 20%);
background-repeat:no-repeat,no-repeat,repeat,repeat,no-repeat,no-repeat;
animation: arnaContactBeam 10s linear infinite, arnaContactGrid 22s linear infinite;
}
@keyframes arnaContactBeam{0%{background-position:0 0,-40% 0,0 0,0 0,0 0,0 0;}100%{background-position:0 0,140% 0,0 0,0 0,0 0,0 0;}}
@keyframes arnaContactGrid{0%{background-position:0 0,-40% 0,0 0,0 0,0 0,0 0;}100%{background-position:0 0,140% 0,64px 0,0 64px,0 0,0 0;}}
@media (max-width:921px){.home #contact{background-size:auto,170% 100%,48px 48px,48px 48px,auto,auto;animation-duration:8.8s,16s;}}

/* Force visible circuit animation on contact section */
.home #contact{
background:
linear-gradient(135deg,#0B1020 0%,#0A162B 38%,#0C2340 72%,#123A63 100%),
linear-gradient(112deg,rgba(11,16,32,0) 0%,rgba(11,16,32,0) 46%,rgba(0,207,255,.18) 50%,rgba(34,211,238,.30) 52%,rgba(0,184,255,.18) 54%,rgba(11,16,32,0) 60%,rgba(11,16,32,0) 100%) -40% 0/180% 100% no-repeat,
linear-gradient(90deg,rgba(0,207,255,.12) 1px,transparent 1px) 0 0/56px 56px,
linear-gradient(0deg,rgba(0,184,255,.10) 1px,transparent 1px) 0 0/56px 56px,
radial-gradient(circle at 22% 24%,rgba(0,207,255,.18) 0,rgba(0,207,255,0) 22%),
radial-gradient(circle at 78% 68%,rgba(34,211,238,.16) 0,rgba(34,211,238,0) 20%) !important;
background-repeat:no-repeat,no-repeat,repeat,repeat,no-repeat,no-repeat !important;
animation: arnaContactBeam 7.8s linear infinite, arnaContactGrid 18s linear infinite !important;
}
@media (max-width:921px){
.home #contact{background-size:auto,165% 100%,44px 44px,44px 44px,auto,auto !important;animation-duration:6.8s,13s !important;}
}

/* Contact overlay layer (guaranteed visible) */
.home #contact{position:relative;overflow:hidden;isolation:isolate;}
.home #contact &gt; *{position:relative;z-index:2;}
.home #contact .contact-circuit-layer{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.60;
background:
linear-gradient(112deg,rgba(11,16,32,0) 0%,rgba(11,16,32,0) 46%,rgba(0,207,255,.20) 50%,rgba(34,211,238,.34) 52%,rgba(0,184,255,.20) 54%,rgba(11,16,32,0) 60%,rgba(11,16,32,0) 100%) -42% 0/190% 100% no-repeat,
linear-gradient(90deg,rgba(0,207,255,.13) 1px,transparent 1px) 0 0/52px 52px,
linear-gradient(0deg,rgba(0,184,255,.11) 1px,transparent 1px) 0 0/52px 52px,
radial-gradient(circle at 22% 24%,rgba(0,207,255,.20) 0,rgba(0,207,255,0) 22%),
radial-gradient(circle at 78% 68%,rgba(34,211,238,.18) 0,rgba(34,211,238,0) 20%);
animation: arnaContactLayerBeam 6.8s linear infinite, arnaContactLayerGrid 15s linear infinite;}
@keyframes arnaContactLayerBeam{0%{background-position:-42% 0,0 0,0 0,0 0,0 0;}100%{background-position:142% 0,0 0,0 0,0 0,0 0;}}
@keyframes arnaContactLayerGrid{0%{background-position:-42% 0,0 0,0 0,0 0,0 0;}100%{background-position:142% 0,52px 0,0 52px,0 0,0 0;}}
@media (max-width:921px){.home #contact .contact-circuit-layer{opacity:.52;background-size:175% 100%,42px 42px,42px 42px,auto,auto;animation-duration:6s,11s;}}

/* Persistent founder card styling */
.home #founders .wp-block-columns .wp-block-column .wp-block-group{background:rgba(245,247,250,0.96) !important;border-radius:16px !important;padding:24px 20px !important;box-shadow:0 12px 36px rgba(7,20,38,0.14);}
.home #founders .wp-block-columns .wp-block-column .wp-block-group:hover{background:#F5F7FA !important;box-shadow:0 16px 44px rgba(0,184,255,0.16);}
/* Arnatech client logo section */
.home .arna-clients-section{
  background:linear-gradient(180deg,#fff 0%,#f6f8fb 100%);
}
.home .arna-clients-section h2{margin-bottom:10px;}
.home .arna-clients-intro{
  max-width:680px;
  margin:0 0 34px;
  color:#526174;
}
.home .arna-client-logo-grid{
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:16px;
}
.home .arna-client-logo-placeholder{
  min-height:112px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:12px;
  border:1px dashed rgba(18,58,99,.22);
  border-radius:14px;
  background:rgba(255,255,255,.82);
  color:#728096;
  font-size:12px;
  font-weight:700;
  letter-spacing:.12em;
  text-transform:uppercase;
  transition:transform .25s ease,box-shadow .25s ease,background .25s ease;
}
.home .arna-client-logo-placeholder:hover{
  transform:translateY(-3px);
  background:#fff;
  box-shadow:0 12px 30px rgba(7,20,38,.08);
}
.home .arna-client-logo-mark{
  width:34px;
  height:34px;
  border:5px solid #123a63;
  border-top-color:#00b8ff;
  border-radius:10px 50% 10px 50%;
  opacity:.58;
  transform:rotate(45deg);
}
@media (max-width:921px){
  .home .arna-client-logo-grid{grid-template-columns:repeat(3,minmax(0,1fr));}
}
@media (max-width:544px){
  .home .arna-client-logo-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;}
  .home .arna-client-logo-placeholder{min-height:100px;}
}
/* Real client and partner logos */
.home .arna-client-logo-item{
  min-height:118px;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:22px 20px;
  border-radius:14px;
  background:rgba(255,255,255,.86);
  box-shadow:0 8px 24px rgba(7,20,38,.05);
  transition:transform .25s ease,box-shadow .25s ease,background .25s ease;
}
.home .arna-client-logo-item:hover{
  transform:translateY(-3px);
  background:#fff;
  box-shadow:0 14px 32px rgba(7,20,38,.10);
}
.home .arna-client-logo-image{
  display:block;
  width:100%;
  max-width:180px;
  height:64px;
  max-height:64px;
  object-fit:contain;
}

/* Homepage centered headings experiment */
.home .entry-content h1,
.home .entry-content h2,
.home .entry-content h3,
.home .entry-content h4,
.home .entry-content h5,
.home .entry-content h6{
  text-align:center !important;
}
.home .wp-block-cover .wp-block-media-text__content p,
.home .arna-clients-intro{
  max-width:680px;
  margin-left:auto !important;
  margin-right:auto !important;
  text-align:center !important;
}

/* Services soft background */
.home #services{
  background:linear-gradient(180deg,#fff 0%,#f6f8fb 100%);
}

/* Unified homepage section spacing */
.home #services,
.home #about,
.home #founders,
.home #clients,
.home #whyus,
.home #contact{
  padding-top:56px !important;
  padding-bottom:64px !important;
}
@media (max-width:544px){
  .home #services,
  .home #about,
  .home #founders,
  .home #clients,
  .home #whyus,
  .home #contact{
    padding-top:44px !important;
    padding-bottom:48px !important;
  }
}

/* About dropdown visibility fix */
@media (min-width:922px){
  .site-header #menu-item-20 .sub-menu{
    background:#fff;
  }
  .site-header #menu-item-20 .sub-menu .menu-link{
    color:#0f172a !important;
    background:transparent !important;
  }
  .site-header #menu-item-20 .sub-menu .menu-link:hover,
  .site-header #menu-item-20 .sub-menu .current-menu-item .menu-link{
    color:#0f172a !important;
    background:#f6f8fb !important;
  }
}

/* Hero copy left alignment */
.home .wp-block-cover .wp-block-media-text__content h1,
.home .wp-block-cover .wp-block-media-text__content p{
  max-width:none;
  margin-left:0 !important;
  margin-right:0 !important;
  text-align:left !important;
}

</style>
</head>

